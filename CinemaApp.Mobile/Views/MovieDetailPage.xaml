<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CinemaApp.Mobile.ViewModels"
             x:Class="CinemaApp.Mobile.Views.MovieDetailPage"
             x:DataType="vm:MovieDetailViewModel"
             Title="{Binding Title}"
             BackgroundColor="#06080D">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">
            <!-- POSTER / HERO -->
            <Border BackgroundColor="#121725" Stroke="#1E2638" StrokeShape="RoundRectangle 12" HeightRequest="260">
                <Image Source="{Binding Movie.PosterUrl}" Aspect="AspectFill" />
            </Border>

            <!-- TITLE & METADATA -->
            <Label Text="{Binding Movie.Title}"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#F8FAFC" />

            <HorizontalStackLayout Spacing="12">
                <Label Text="{Binding Movie.ReleaseYear}" TextColor="#94A3B8" FontSize="13" />
                <Label Text="•" TextColor="#64748B" FontSize="13" />
                <Label Text="{Binding Movie.DurationMinutes, StringFormat='{0} minutes'}" TextColor="#94A3B8" FontSize="13" />
                <Label Text="•" TextColor="#64748B" FontSize="13" />
                <Label Text="{Binding Movie.Genres}" TextColor="#06B6D4" FontSize="13" FontAttributes="Bold" />
            </HorizontalStackLayout>

            <!-- SYNOPSIS -->
            <Label Text="Synopsis" FontSize="16" FontAttributes="Bold" TextColor="#F8FAFC" Margin="0,8,0,0" />
            <Label Text="{Binding Movie.Description}" TextColor="#94A3B8" FontSize="14" LineHeight="1.4" />

            <!-- QUALITY SELECTOR -->
            <Label Text="Select Stream Quality" FontSize="14" FontAttributes="Bold" TextColor="#F8FAFC" Margin="0,8,0,0" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="360p" Clicked="OnQualityClicked" CommandParameter="360p" BackgroundColor="#141A29" TextColor="#94A3B8" CornerRadius="6" />
                <Button Text="480p" Clicked="OnQualityClicked" CommandParameter="480p" BackgroundColor="#141A29" TextColor="#94A3B8" CornerRadius="6" />
                <Button Text="720p ★" Clicked="OnQualityClicked" CommandParameter="720p" BackgroundColor="#141A29" TextColor="#F59E0B" CornerRadius="6" />
                <Button Text="1080p ★" Clicked="OnQualityClicked" CommandParameter="1080p" BackgroundColor="#141A29" TextColor="#F59E0B" CornerRadius="6" />
            </HorizontalStackLayout>

            <!-- PLAY BUTTON -->
            <Button Text="▶ Play Stream"
                    Clicked="OnPlayClicked"
                    BackgroundColor="#06B6D4"
                    TextColor="#06080D"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="10"
                    HeightRequest="50"
                    Margin="0,16,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
