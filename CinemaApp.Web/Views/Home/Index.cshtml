@model CinemaApp.Web.Models.HomeCatalogViewModel
@{
    ViewData["Title"] = "Streaming Catalog";
    var featured = Model.FeaturedMovie;
    var ui = Context.Request.Cookies["cinema_lang"] ?? "en-US";
}

<div class="content-wrapper" style="padding-top: 1.5rem;">

    <!-- CATALOG: SIDEBAR FILTERS + MAIN GRID -->
    <div class="catalog-layout">

        <!-- FILTER SIDEBAR -->
        <aside class="filter-sidebar">
            <h3 class="filter-heading">🎛️ @UiStrings.Tr(ui, "Filters")</h3>

            <form method="get" asp-controller="Home" asp-action="Index">
                <input type="hidden" name="lang" value="@Model.CurrentCulture" />
                <input type="hidden" name="search" value="@Model.SearchQuery" />
                <input type="hidden" name="sort" value="@Model.SelectedSort" />

                <div class="filter-group">
                    <div class="filter-title">@UiStrings.Tr(ui, "Category")</div>
                    <div class="filter-list">
                        <a href="@Url.Action("Index", new { lang = Model.CurrentCulture, search = Model.SearchQuery, sort = Model.SelectedSort, year = Model.SelectedYear, minRating = Model.MinRating })"
                           class="filter-link @(!Model.SelectedCategoryId.HasValue ? "active" : "")">
                            <span>🍿</span> @UiStrings.Tr(ui, "All Genres")
                        </a>
                        @foreach (var cat in Model.Categories)
                        {
                            <a href="@Url.Action("Index", new { categoryId = cat.Id, lang = Model.CurrentCulture, search = Model.SearchQuery, sort = Model.SelectedSort, year = Model.SelectedYear, minRating = Model.MinRating })"
                               class="filter-link @(Model.SelectedCategoryId == cat.Id ? "active" : "")">
                                <span>🎬</span> @cat.Name
                            </a>
                        }
                    </div>
                </div>

                <div class="filter-group">
                    <label class="filter-title" for="yearSelect">@UiStrings.Tr(ui, "Year")</label>
                    <select id="yearSelect" name="year" class="form-control">
                        <option value="">@UiStrings.Tr(ui, "Any year")</option>
                        @foreach (var y in Model.Years)
                        {
                            <option value="@y" selected="@(Model.SelectedYear == y)">@y</option>
                        }
                    </select>
                </div>

                <div class="filter-group">
                    <label class="filter-title" for="ratingSelect">@UiStrings.Tr(ui, "Rating")</label>
                    <select id="ratingSelect" name="minRating" class="form-control">
                        <option value="">@UiStrings.Tr(ui, "Any rating")</option>
                        <option value="4" selected="@(Model.MinRating == 4)">4.0+</option>
                        <option value="4.5" selected="@(Model.MinRating == 4.5m)">4.5+</option>
                        <option value="5" selected="@(Model.MinRating == 5)">5.0</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary" style="width: 100%;">@UiStrings.Tr(ui, "Apply filters")</button>
                @if (Model.SelectedCategoryId.HasValue || !string.IsNullOrWhiteSpace(Model.SearchQuery) || Model.SelectedYear.HasValue || Model.MinRating.HasValue)
                {
                    <a href="@Url.Action("Index", new { lang = Model.CurrentCulture })" class="btn btn-secondary" style="width: 100%; margin-top: 0.6rem; text-align: center; display: block;">
                        ✕ @UiStrings.Tr(ui, "Remove filters")
                    </a>
                }
            </form>
        </aside>

        <!-- MAIN CATALOG -->
        <div class="catalog-main">

            <!-- COMPACT NEWEST FEATURE (only on the "New" sort) -->
            @if (featured != null && Model.SelectedSort == "new")
            {
                <div class="mini-featured" onclick="window.location='@Url.Action("Watch", "Home", new { id = featured.Id, lang = Model.CurrentCulture })'" style="cursor: pointer;">
                    <a asp-controller="Home" asp-action="Watch" asp-route-id="@featured.Id" asp-route-lang="@Model.CurrentCulture" style="display:contents; color:inherit; text-decoration:none;">
                        <img src="@(featured.PosterUrl ?? MediaUrls.FallbackPoster)" alt="@featured.Title" class="mini-featured-poster"
                             onerror="this.onerror=null; this.src='@MediaUrls.FallbackPoster';" />
                    </a>
                    <div class="mini-featured-body">
                        <span class="mini-featured-badge">🆕 @UiStrings.Tr(ui, "New Releases")</span>
                        <a asp-controller="Home" asp-action="Watch" asp-route-id="@featured.Id" asp-route-lang="@Model.CurrentCulture" style="color:inherit; text-decoration:none;">
                            <h2 class="mini-featured-title">@featured.Title</h2>
                        </a>
                        <div class="mini-featured-meta">
                            <span>📅 @featured.ReleaseYear</span>
                            <span>⏱️ @featured.DurationMinutes @UiStrings.Tr(ui, "minutes")</span>
                            <span>🎭 @featured.Genres</span>
                            @if (featured.RatingCount > 0)
                            {
                                <span class="mini-featured-rating">★ @featured.AverageRating.ToString("0.0")</span>
                            }
                        </div>
                        <p class="mini-featured-desc">@featured.Description</p>
                        <div style="display: flex; gap: 0.75rem; align-items: center;" onclick="event.stopPropagation();">
                            <a asp-controller="Home" asp-action="Watch" asp-route-id="@featured.Id" asp-route-lang="@Model.CurrentCulture" class="btn btn-primary btn-sm">
                                <span>▶</span> @UiStrings.Tr(ui, "Play")
                            </a>
                            <a asp-controller="Account" asp-action="Subscription" class="btn btn-gold btn-sm">
                                <span>⭐</span> @UiStrings.Tr(ui, "Unlock Pro Qualities")
                            </a>
                        </div>
                    </div>
                </div>
            }

            <div class="catalog-toolbar">
                <div class="sort-tabs">
                    <a href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, lang = Model.CurrentCulture, search = Model.SearchQuery, year = Model.SelectedYear, minRating = Model.MinRating, sort = "new" })"
                       class="sort-tab @(Model.SelectedSort == "new" ? "active" : "")">
                        <span>🆕</span> @UiStrings.Tr(ui, "New")
                    </a>
                    <a href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, lang = Model.CurrentCulture, search = Model.SearchQuery, year = Model.SelectedYear, minRating = Model.MinRating, sort = "top" })"
                       class="sort-tab @(Model.SelectedSort == "top" ? "active" : "")">
                        <span>🏆</span> @UiStrings.Tr(ui, "Top Rated")
                    </a>
                </div>

                <form method="get" class="search-box">
                    <input type="hidden" name="lang" value="@Model.CurrentCulture" />
                    @if (Model.SelectedCategoryId.HasValue)
                    {
                        <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId.Value" />
                    }
                    <input type="hidden" name="sort" value="@Model.SelectedSort" />
                    @if (Model.SelectedYear.HasValue)
                    {
                        <input type="hidden" name="year" value="@Model.SelectedYear.Value" />
                    }
                    @if (Model.MinRating.HasValue)
                    {
                        <input type="hidden" name="minRating" value="@Model.MinRating.Value" />
                    }
                    <span>🔍</span>
                    <input type="text" name="search" value="@Model.SearchQuery" placeholder="@UiStrings.Tr(ui, "Search movies, actors, genres...")" />
                </form>
            </div>
 
            @if (Model.SelectedCategoryId.HasValue || !string.IsNullOrWhiteSpace(Model.SearchQuery) || Model.SelectedYear.HasValue || Model.MinRating.HasValue)
            {
                <div style="display: flex; align-items: center; justify-content: space-between; background: rgba(20, 26, 41, 0.7); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 0.6rem 1rem; margin-bottom: 1.25rem;">
                    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                        <span style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">@UiStrings.Tr(ui, "Active Filters"):</span>
                        @if (Model.SelectedCategoryId.HasValue)
                        {
                            var catName = Model.Categories.FirstOrDefault(c => c.Id == Model.SelectedCategoryId.Value)?.Name ?? "Category";
                            <span style="font-size: 0.8rem; background: rgba(6, 182, 212, 0.15); border: 1px solid var(--accent-cyan); color: var(--accent-cyan); padding: 2px 8px; border-radius: 999px;">🎬 @catName</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                        {
                            <span style="font-size: 0.8rem; background: rgba(6, 182, 212, 0.15); border: 1px solid var(--accent-cyan); color: var(--accent-cyan); padding: 2px 8px; border-radius: 999px;">🔍 "@Model.SearchQuery"</span>
                        }
                        @if (Model.SelectedYear.HasValue)
                        {
                            <span style="font-size: 0.8rem; background: rgba(6, 182, 212, 0.15); border: 1px solid var(--accent-cyan); color: var(--accent-cyan); padding: 2px 8px; border-radius: 999px;">📅 @Model.SelectedYear.Value</span>
                        }
                        @if (Model.MinRating.HasValue)
                        {
                            <span style="font-size: 0.8rem; background: rgba(6, 182, 212, 0.15); border: 1px solid var(--accent-cyan); color: var(--accent-cyan); padding: 2px 8px; border-radius: 999px;">⭐ @Model.MinRating.Value+</span>
                        }
                    </div>
                    <a href="@Url.Action("Index", new { lang = Model.CurrentCulture })" class="btn btn-secondary btn-sm" style="color: #F43F5E; border-color: rgba(244, 63, 94, 0.4); text-decoration: none;">
                        ✕ @UiStrings.Tr(ui, "Remove filters")
                    </a>
                </div>
            }

            <!-- MOVIE GRID -->
            <div class="movie-grid">
                @if (Model.Movies.Count == 0)
                {
                    <div style="grid-column: 1 / -1; text-align: center; padding: 4rem 0; color: var(--text-muted);">
                        <h3>@UiStrings.Tr(ui, "No movies found")</h3>
                        <p>@UiStrings.Tr(ui, "Try clearing your search query or selecting a different category.")</p>
                    </div>
                }

                @foreach (var movie in Model.Movies)
                {
                    <div class="movie-card" onclick="window.location='@Url.Action("Watch", "Home", new { id = movie.Id, lang = Model.CurrentCulture })'" style="cursor: pointer;">
                        <a asp-controller="Home" asp-action="Watch" asp-route-id="@movie.Id" asp-route-lang="@Model.CurrentCulture" class="movie-poster-wrap" style="display: block; text-decoration: none;">
                            <img src="@(movie.PosterUrl ?? MediaUrls.FallbackPoster)" alt="@movie.Title" class="movie-poster"
                                 onerror="this.onerror=null; this.src='@MediaUrls.FallbackPoster';" />

                            @if (movie.AvailableQualities.Any(q => q == "1080p"))
                            {
                                <span class="movie-quality-badge">1080p FHD</span>
                            }
                            else if (movie.AvailableQualities.Any(q => q == "720p"))
                            {
                                <span class="movie-quality-badge">720p HD</span>
                            }
                            else
                            {
                                <span class="movie-quality-badge">480p SD</span>
                            }

                            @if (movie.RatingCount > 0)
                            {
                                <span class="movie-rating-badge">★ @movie.AverageRating.ToString("0.0")</span>
                            }
                            else
                            {
                                <span class="movie-rating-badge dim">@UiStrings.Tr(ui, "Not rated")</span>
                            }
                        </a>

                        <div class="movie-card-body">
                            <a asp-controller="Home" asp-action="Watch" asp-route-id="@movie.Id" asp-route-lang="@Model.CurrentCulture" style="text-decoration: none; color: inherit;">
                                <h3 class="movie-card-title" title="@movie.Title">@movie.Title</h3>
                            </a>
                            <p class="movie-card-genres">@movie.Genres</p>

                            <p style="font-size: 0.8rem; color: var(--text-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 0.75rem;">
                                @movie.Description
                            </p>

                            <div class="movie-card-footer" onclick="event.stopPropagation();">
                                <span>📅 @movie.ReleaseYear • ⏱️ @movie.DurationMinutes m</span>
                                <a asp-controller="Home" asp-action="Watch" asp-route-id="@movie.Id" asp-route-lang="@Model.CurrentCulture" class="btn btn-primary btn-sm">
                                    <span>▶</span> @UiStrings.Tr(ui, "Play")
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>