@{
    ViewData["Title"] = "Open Support Ticket";
}

<div style="max-width: 760px; margin: 2rem auto; padding: 0 1.5rem;">
    <!-- Breadcrumbs -->
    <div style="margin-bottom: 1rem;">
        <a asp-action="Index" style="color: #06B6D4; text-decoration: none; font-size: 0.9rem; font-weight: 600;">← Back to Tickets</a>
    </div>

    <!-- Form Container -->
    <div style="background: linear-gradient(135deg, rgba(18, 24, 38, 0.95), rgba(10, 14, 23, 0.98)); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 20px; padding: 2.25rem; box-shadow: 0 20px 40px rgba(0,0,0,0.5); backdrop-filter: blur(20px);">
        
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 1.5rem;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(6, 182, 212, 0.15); display: flex; align-items: center; justify-content: center; font-size: 1.4rem;">
                🎧
            </div>
            <div>
                <h1 style="margin: 0; font-size: 1.5rem; font-weight: 800; color: #F8FAFC;">Open a Support Ticket</h1>
                <p style="margin: 2px 0 0; color: #94A3B8; font-size: 0.88rem;">Our staff will review your request and get back to you promptly.</p>
            </div>
        </div>

        @if (ViewBag.Error != null)
        {
            <div style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.4); color: #FECACA; padding: 12px 16px; border-radius: 10px; font-size: 0.9rem; margin-bottom: 1.5rem;">
                @ViewBag.Error
            </div>
        }

        <form asp-action="Create" method="post" style="display: flex; flex-direction: column; gap: 1.25rem;">
            @Html.AntiForgeryToken()

            <!-- Subject -->
            <div>
                <label style="display: block; font-size: 0.88rem; font-weight: 700; color: #E2E8F0; margin-bottom: 6px;">
                    Subject / Title <span style="color: #EF4444;">*</span>
                </label>
                <input type="text" name="subject" required placeholder="Brief summary of your question or issue (e.g., Movie audio sync)" style="width: 100%; background: rgba(14, 18, 30, 0.95); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 10px; padding: 12px 14px; color: #F8FAFC; font-size: 0.95rem; outline: none; box-sizing: border-box; transition: border-color 0.2s;" onfocus="this.style.borderColor='#06B6D4'" onblur="this.style.borderColor='rgba(255, 255, 255, 0.14)'" />
            </div>

            <!-- Row for Category and Priority -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <!-- Category -->
                <div>
                    <label style="display: block; font-size: 0.88rem; font-weight: 700; color: #E2E8F0; margin-bottom: 6px;">
                        Category
                    </label>
                    <select name="category" style="width: 100%; background: #0E121E; border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 10px; padding: 12px 14px; color: #F8FAFC; font-size: 0.95rem; outline: none; box-sizing: border-box;">
                        <option value="Streaming & Playback">🎬 Streaming & Playback</option>
                        <option value="Technical">⚙️ Technical / App Bug</option>
                        <option value="Billing & Subscription">💳 Billing & Subscription</option>
                        <option value="Movie Request">🍿 Movie / Content Request</option>
                        <option value="General">💬 General Inquiry</option>
                    </select>
                </div>

                <!-- Priority -->
                <div>
                    <label style="display: block; font-size: 0.88rem; font-weight: 700; color: #E2E8F0; margin-bottom: 6px;">
                        Priority
                    </label>
                    <select name="priority" style="width: 100%; background: #0E121E; border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 10px; padding: 12px 14px; color: #F8FAFC; font-size: 0.95rem; outline: none; box-sizing: border-box;">
                        <option value="Normal">🟢 Normal</option>
                        <option value="High">🟡 High</option>
                        <option value="Urgent">🔴 Urgent</option>
                    </select>
                </div>
            </div>

            <!-- Detailed Message -->
            <div>
                <label style="display: block; font-size: 0.88rem; font-weight: 700; color: #E2E8F0; margin-bottom: 6px;">
                    Description / Details <span style="color: #EF4444;">*</span>
                </label>
                <textarea name="message" required rows="6" placeholder="Please describe the issue in detail. Include any movie titles, browser/device info, or steps to reproduce." style="width: 100%; background: rgba(14, 18, 30, 0.95); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 10px; padding: 12px 14px; color: #F8FAFC; font-size: 0.95rem; outline: none; box-sizing: border-box; resize: vertical; transition: border-color 0.2s;" onfocus="this.style.borderColor='#06B6D4'" onblur="this.style.borderColor='rgba(255, 255, 255, 0.14)'"></textarea>
            </div>

            <!-- Submit Button -->
            <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 10px;">
                <a asp-action="Index" style="display: inline-flex; align-items: center; padding: 11px 20px; border-radius: 10px; background: rgba(255,255,255,0.06); color: #94A3B8; text-decoration: none; font-weight: 600; font-size: 0.95rem;">
                    Cancel
                </a>
                <button type="submit" style="display: inline-flex; align-items: center; gap: 8px; background: linear-gradient(135deg, #06B6D4, #0284C7); color: #06080D; font-weight: 700; padding: 11px 24px; border-radius: 10px; border: none; font-size: 0.95rem; cursor: pointer; box-shadow: 0 4px 15px rgba(6, 182, 212, 0.4);">
                    <span>🚀</span> Submit Ticket
                </button>
            </div>
        </form>
    </div>
</div>
