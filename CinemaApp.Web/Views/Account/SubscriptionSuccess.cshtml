@{
    ViewData["Title"] = "Subscription Activated!";
    var ui = Context.Request.Cookies["cinema_lang"] ?? "en-US";
}

<div class="content-wrapper" style="padding-top: 5rem; max-width: 600px; text-align: center;">
    <div class="admin-card" style="padding: 3rem 2rem; border-color: var(--accent-gold); box-shadow: var(--shadow-gold);">
        <div style="font-size: 4rem; margin-bottom: 1rem;">🎉</div>
        <span class="hero-badge" style="background: rgba(245, 158, 11, 0.2); color: var(--accent-gold); border-color: var(--accent-gold);">
            PAYMENT CONFIRMED
        </span>
        <h1 style="font-size: 2.25rem; margin-top: 0.5rem; margin-bottom: 0.75rem;">@UiStrings.Tr(ui, "Welcome to Cinema Pro!")</h1>
        <p style="color: var(--text-muted); font-size: 1.05rem; margin-bottom: 2rem;">
            @UiStrings.Tr(ui, "Your account has been upgraded successfully. Full HD 1080p and 720p streams are now instantly unlocked for your web and Android devices.")
        </p>

        <div style="display: flex; gap: 1rem; justify-content: center;">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary" style="padding: 0.75rem 2rem;">
                <span>🍿</span> @UiStrings.Tr(ui, "Start Watching in 1080p")
            </a>
        </div>
    </div>
</div>
