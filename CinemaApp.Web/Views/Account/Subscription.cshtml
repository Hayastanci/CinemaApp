@{
    ViewData["Title"] = "Cinema Pro VIP Subscription";
    bool isSubscribed = ViewBag.IsSubscribed == true;
    var ui = Context.Request.Cookies["cinema_lang"] ?? "en-US";
}

<div class="content-wrapper" style="padding-top: 3rem; max-width: 900px; text-align: center;">
    <div style="margin-bottom: 2rem;">
        <span class="hero-badge">⭐ CINEMA PRO ALL-ACCESS</span>
        <h1 style="font-size: 2.75rem; margin-top: 0.5rem; margin-bottom: 0.75rem;">@UiStrings.Tr(ui, "Elevate Your Streaming Experience")</h1>
        <p style="color: var(--text-muted); font-size: 1.1rem; max-width: 600px; margin: 0 auto;">
            Unlock crisp 1080p Full HD video streams, priority bandwidth, and cross-platform access on Web and Android.
        </p>
    </div>

    @if (isSubscribed)
    {
        <div style="background: rgba(16, 185, 129, 0.15); border: 1px solid var(--accent-green); border-radius: var(--radius-lg); padding: 2.5rem; margin-bottom: 3rem;">
            <div style="font-size: 3rem; margin-bottom: 0.5rem;">👑</div>
            <h2 style="color: #6ee7b7; font-size: 1.8rem; margin-bottom: 0.5rem;">@UiStrings.Tr(ui, "You are a Cinema Pro VIP!")</h2>
            <p style="color: var(--text-muted); margin-bottom: 1.5rem;">All premium 720p and 1080p streams are unlocked across all devices.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">@UiStrings.Tr(ui, "Browse Movie Catalog")</a>
        </div>
    }
    else
    {
        <!-- PLAN COMPARISON -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 3rem; text-align: left;">
            <!-- FREE TIER -->
            <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 2.5rem; display: flex; flex-direction: column;">
                <div style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); font-weight: 700; margin-bottom: 0.5rem;">@UiStrings.Tr(ui, "Standard Tier")</div>
                <div style="font-size: 2.5rem; font-weight: 800; font-family: var(--font-heading); margin-bottom: 1.5rem;">$0 <span style="font-size: 1rem; color: var(--text-dim); font-weight: 400;">/ @UiStrings.Tr(ui, "forever")</span></div>
                
                <ul style="list-style: none; margin-bottom: 2rem; flex: 1; display: flex; flex-direction: column; gap: 0.85rem; font-size: 0.95rem; color: var(--text-muted);">
                    <li><span style="color: var(--accent-green); margin-right: 0.5rem;">✓</span> @UiStrings.Tr(ui, "Access to movie catalog")</li>
                    <li><span style="color: var(--accent-green); margin-right: 0.5rem;">✓</span> @UiStrings.Tr(ui, "Standard Definition (360p & 480p)")</li>
                    <li><span style="color: var(--accent-green); margin-right: 0.5rem;">✓</span> @UiStrings.Tr(ui, "Multilingual subtitles & metadata")</li>
                    <li style="color: var(--text-dim);"><span style="margin-right: 0.5rem;">✗</span> @UiStrings.Tr(ui, "720p & 1080p HD Restricted")</li>
                    <li style="color: var(--text-dim);"><span style="margin-right: 0.5rem;">✗</span> @UiStrings.Tr(ui, "Priority CDN Bandwidth")</li>
                </ul>

                <button class="btn btn-secondary" style="width: 100%; cursor: default;">@UiStrings.Tr(ui, "Current Plan")</button>
            </div>

            <!-- PRO TIER -->
            <div style="background: linear-gradient(180deg, rgba(245, 158, 11, 0.08) 0%, rgba(18, 23, 37, 0.9) 100%); border: 2px solid var(--accent-gold); border-radius: var(--radius-lg); padding: 2.5rem; display: flex; flex-direction: column; position: relative; box-shadow: var(--shadow-gold);">
                <span style="position: absolute; top: -12px; right: 24px; background: var(--accent-gold); color: #000; font-weight: 800; font-size: 0.75rem; padding: 2px 10px; border-radius: 999px;">@UiStrings.Tr(ui, "RECOMMENDED")</span>
                
                <div style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent-gold); font-weight: 700; margin-bottom: 0.5rem;">@UiStrings.Tr(ui, "Cinema Pro Pass")</div>
                <div style="font-size: 2.5rem; font-weight: 800; font-family: var(--font-heading); margin-bottom: 1.5rem;">$9.99 <span style="font-size: 1rem; color: var(--text-muted); font-weight: 400;">/ @UiStrings.Tr(ui, "month")</span></div>

                <ul style="list-style: none; margin-bottom: 2rem; flex: 1; display: flex; flex-direction: column; gap: 0.85rem; font-size: 0.95rem;">
                    <li><span style="color: var(--accent-gold); margin-right: 0.5rem;">★</span> <strong>@UiStrings.Tr(ui, "Full 1080p FHD & 720p HD Streaming")</strong></li>
                    <li><span style="color: var(--accent-gold); margin-right: 0.5rem;">★</span> @UiStrings.Tr(ui, "Cross-platform Android App playback")</li>
                    <li><span style="color: var(--accent-gold); margin-right: 0.5rem;">★</span> @UiStrings.Tr(ui, "Instant zero-buffering byte-range seeking")</li>
                    <li><span style="color: var(--accent-gold); margin-right: 0.5rem;">★</span> @UiStrings.Tr(ui, "Ad-free cinema immersion")</li>
                    <li><span style="color: var(--accent-gold); margin-right: 0.5rem;">★</span> @UiStrings.Tr(ui, "Cancel anytime with 1-click")</li>
                </ul>

                <form asp-action="StartSubscriptionCheckout" method="post">
                    <button type="submit" class="btn btn-gold" style="width: 100%; padding: 0.85rem; font-size: 1.05rem;">
                        <span>💳</span> @UiStrings.Tr(ui, "Subscribe via Stripe ($9.99/mo)")
                    </button>
                </form>
            </div>
        </div>
    }
</div>
